# Database: Defaults to local SQLite if left empty or commented out.
# For SQLite: sqlite:///./railway.db
# For PostgreSQL: postgresql://username:password@localhost:5432/railway
DATABASE_URL=sqlite:///./railway.db

# Redis Cache: Optional (gracefully falls back to in-memory cache if offline)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Secret & Settings
SECRET_KEY=bd_railway_secret_key_super_secure_jwt_token_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
