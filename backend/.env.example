# Application Mode: MOCK (offline/simulation) or LIVE (Official Playwright automation)
APP_MODE=MOCK
APP_ENV=development

# Polling Interval (in seconds) with jitter
MONITOR_INTERVAL_SECONDS=15
MONITOR_MIN_INTERVAL_SECONDS=10
MONITOR_MAX_INTERVAL_SECONDS=30

# Optional Telegram Notifications (Leave empty if not using)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Database: Defaults to local SQLite if left empty.
# For SQLite: sqlite:///./railway.db
# For PostgreSQL: postgresql://username:password@localhost:5432/railway
DATABASE_URL=sqlite:///./railway.db

# Redis Cache: Optional (gracefully falls back to in-memory cache if offline)
REDIS_HOST=localhost
REDIS_PORT=6379

# Allowed CORS Origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT Settings
SECRET_KEY=bd_railway_secret_key_super_secure_jwt_token_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
