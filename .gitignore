# Combined .gitignore for Monorepo
# Frontend
/frontend/node_modules
/frontend/.pnp
/frontend/.pnp.js
/frontend/.yarn/install-state.gz
/frontend/coverage
/frontend/.next/
/frontend/out/
/frontend/build
/frontend/.vercel
/frontend/*.tsbuildinfo
/frontend/next-env.d.ts
/frontend/.env*.local

# Backend
/backend/__pycache__/
/backend/.venv/
/backend/env/
/backend/venv/
/backend/*.pyc

# Generic
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
